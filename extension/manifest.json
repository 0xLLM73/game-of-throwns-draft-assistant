{
  "manifest_version": 3,
  "name": "Game of Throwns Draft Assistant",
  "description": "ESPN draft recommendations plus weekly Vegas half-PPR projections, K/DST estimates, weather, lineup optimizer, win odds and inactive alerts.",
  "version": "0.13.0",
  "permissions": [
    "storage",
    "alarms",
    "power",
    "notifications"
  ],
  "host_permissions": [
    "https://fantasy.espn.com/*",
    "https://www.parlaysavant.com/*",
    "https://site.api.espn.com/*",
    "https://api.open-meteo.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://fantasy.espn.com/football/*"
      ],
      "js": [
        "lib/weekly.js",
        "lib/weekly-calendar.js",
        "lib/weekly-dom.js",
        "lib/weekly-estimates.js",
        "lib/weekly-matchup.js",
        "lib/weekly-waivers.js",
        "weekly-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://fantasy.espn.com/football/draft*"
      ],
      "js": [
        "lib/engine.js",
        "lib/espn-detector.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "data/rankings.json"
      ],
      "matches": [
        "https://fantasy.espn.com/*"
      ]
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Game of Throwns Draft Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
