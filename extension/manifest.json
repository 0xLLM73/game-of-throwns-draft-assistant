{
  "manifest_version": 3,
  "name": "Game of Throwns Draft Assistant",
  "description": "ESPN draft recommendations and weekly lineup Vegas half-PPR projections, cached locally with source and coverage details.",
  "version": "0.11.0",
  "permissions": ["storage", "alarms", "power"],
  "host_permissions": ["https://fantasy.espn.com/*", "https://www.parlaysavant.com/*", "https://site.api.espn.com/*"],
  "content_scripts": [
    {
      "matches": ["https://fantasy.espn.com/football/*"],
      "js": ["lib/weekly.js", "lib/weekly-matchup.js", "lib/weekly-waivers.js", "weekly-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://fantasy.espn.com/football/draft*"],
      "js": ["lib/engine.js", "lib/espn-detector.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["data/rankings.json"],
      "matches": ["https://fantasy.espn.com/*"]
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Game of Throwns Draft Assistant"
  }
}
